<?xml version="1.0" encoding="utf-8"?>
<!-- Personal fork. Restricted to Brave and Chrome: the service only reads the address bar of those
     browsers, and only when the autofill report button is pressed. It listens to no events. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:packageNames="com.brave.browser,com.brave.browser_beta,com.brave.browser_nightly,com.android.chrome"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:description="@string/url_reader_service_description" />
